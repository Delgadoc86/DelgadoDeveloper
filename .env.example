# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX).
# Se obtiene en analytics.google.com al crear una propiedad "Web" para el sitio.
# Sin esta variable, Google Analytics simplemente no se carga (no rompe el build ni el sitio).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Config web pública del proyecto Firebase "DelgadoDev Gestión" (panel /admin).
# Se obtiene en Firebase Console > Project Settings > tu app web.
# Es pública por diseño de Firebase (protegida por Firestore Security Rules,
# no por ocultar el apiKey), pero igual no se hardcodea en el código.
NEXT_PUBLIC_FIREBASE_GESTION_API_KEY=
NEXT_PUBLIC_FIREBASE_GESTION_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_GESTION_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_GESTION_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_GESTION_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_GESTION_APP_ID=

# Credenciales de Firebase Admin (service account) para el panel /admin.
# Se generan en Firebase Console > Project Settings > Service Accounts >
# Generate new private key. Server-only: nunca se exponen al cliente ni se
# commitean. FIREBASE_GESTION_ADMIN_PRIVATE_KEY suele venir con saltos
# de línea "\n" escapados; conservar ese formato tal cual lo entrega Firebase.
FIREBASE_GESTION_ADMIN_PROJECT_ID=
FIREBASE_GESTION_ADMIN_CLIENT_EMAIL=
FIREBASE_GESTION_ADMIN_PRIVATE_KEY=

# App Check (opcional) para el panel /admin. Se obtiene registrando un site
# key de reCAPTCHA v3 en Firebase Console > App Check > tu app web. Sin esta
# variable, el panel funciona igual, solo sin esta capa extra de protección
# contra tráfico que no viene de la app real.
NEXT_PUBLIC_FIREBASE_GESTION_APPCHECK_SITE_KEY=
