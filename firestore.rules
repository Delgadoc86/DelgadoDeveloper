rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    // Un admin puede leer su propio documento (para chequeos desde cliente).
    // Los documentos de adminUsers solo se crean/editan manualmente desde
    // Firebase Console o vía Admin SDK (Route Handlers) — nunca desde cliente.
    match /adminUsers/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Solo el admin lee/escribe. El público nunca toca esta colección desde
    // el cliente: /descargar/[slug] la consulta server-side con Admin SDK
    // (que ignora estas reglas), así que no hace falta ningún acceso público.
    match /apps/{slug} {
      allow read, write: if isAdmin();
    }

    // Todo lo demás queda cerrado por defecto. Cada colección (customers,
    // products, subscriptions, payments, counters, receipts, auditLogs,
    // settings) recibe sus propias reglas explícitas en la etapa del roadmap
    // en la que se construye, en vez de abrir un acceso genérico para
    // colecciones que todavía no existen.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
